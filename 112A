// A new code forces problem for beginners

#include<iostream>
using namespace std;
int main(){
        int i = 0;
        string first{}, second{};
        cin >> first >> second;
// Converting both strings to lower case;
        for(int x = 0; x < first.length(); x++){
            if(first[x] >= 'A' && first[x] <= 'Z'){
                first[x] += 32;
            }
            if(second[x] >= 'A' && second[x] <= 'Z'){
                second[x] += 32;

            }
        }
// extracting th point of disjunction
        for(i = 0; i < first.length(); i++){
            if(first[i] != second[i]){
                break;
            }
        }
        if(first[i] > second[i]){
            cout << 1;
        }
        else if(first[i] < second[i]){
            cout << -1;
        }
        else{
            cout << 0;
        }
        cout << endl;
       
}
