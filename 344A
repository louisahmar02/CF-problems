#include<iostream>
using namespace std;
int main(){
     int count{}, n{};
     cin >> n;
     int arr[n];
     for(int i = 0; i < n; i++){
          cin >> arr[i];
     }
     for(int i = 0; i < n-1; i++){
          if(arr[i]!=arr[i+1])
          count++;
     }
     if(count==1)
     count+=2;
     else
     count++;
     cout << count;
     return 0;
}

