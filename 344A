//Codeforces problem
//A. Magnets
#include <iostream>
using namespace std;
int main() {
    int input{}, count{}, test{};
    int temp;
    cin >> test;
        cin >> input;
        temp = input;
    for(int i = 0; i < test-1; i++){
        cin >> input;
        if(input!=temp){
            count++;
        }
        temp = input;
    }
    cout << count+1;
    return 0;
}
